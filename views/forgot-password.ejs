<%- include('partials/header') %>
<section class="auth-layout compact-auth">
  <div class="auth-aside"><p class="eyebrow">ACCOUNT RECOVERY</p><h1>A fresh<br><em>beginning.</em></h1><p>Verify your account details, then choose a new password.</p></div>
  <div class="form-panel"><h2>Reset password</h2>
    <form action="/forgot-password" method="post" class="stack-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label>User ID<input name="userId" required maxlength="40"></label>
      <label>ZIP / postal code<input name="zipCode" required maxlength="16"></label>
      <label>Mobile number<input name="mobile" required maxlength="24"></label>
      <label>New password<input name="newPassword" type="password" required minlength="8" autocomplete="new-password"></label>
      <label>Confirm password<input name="confirmPassword" type="password" required minlength="8" autocomplete="new-password"></label>
      <button class="button button-dark button-full" type="submit">Update password <span aria-hidden="true">↗</span></button>
    </form>
  </div>
</section>
<%- include('partials/footer') %>
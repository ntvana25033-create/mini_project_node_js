<%- include('partials/header') %>
<section class="dashboard-heading"><div><p class="eyebrow">PUBLISHER DESK</p><h1>Bring a story<br><em>into the room.</em></h1><p>Submit advance copies for review before publication.</p></div><span class="dashboard-mark publisher-mark">P</span></section>
<section class="publisher-layout"><div class="form-panel"><p class="eyebrow">NEW ADVANCE COPY</p><h2>Submit a book</h2><form action="/publisher/books" method="post" class="stack-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Book title<input name="title" required maxlength="160"></label><label>Author<input name="author" required maxlength="120"></label><label>Category<select name="category" required><option value="">Choose a shelf</option><% ['Fiction','Science','Technology','Mystery','History','Business','Other'].forEach((category) => { %><option value="<%= category %>"><%= category %></option><% }) %></select></label><label>Cover image URL <span class="optional">optional</span><input name="coverUrl" type="url" maxlength="1000" placeholder="https://..."></label><label>Book description<textarea name="description" rows="6" required maxlength="4000"></textarea></label><button class="button button-dark button-full" type="submit">Send for review <span aria-hidden="true">↗</span></button></form></div>
  <div class="submission-list"><div class="section-heading"><div><p class="eyebrow">YOUR SUBMISSIONS</p><h2>Review queue</h2></div><span class="result-count"><%= books.length %></span></div><% if (books.length) { books.forEach((book) => { %><article class="submission-row"><div><h3><%= book.title %></h3><p><%= book.author %> · <%= book.category %></p></div><span class="status status-<%= book.status %>"><%= book.status %></span></article><% }) } else { %><p class="empty-line">Your submitted books will appear here.</p><% } %></div>
</section>
<%- include('partials/footer') %>
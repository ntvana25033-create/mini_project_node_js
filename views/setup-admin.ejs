<%- include('partials/header') %>
<section class="auth-layout compact-auth">
  <div class="auth-aside"><p class="eyebrow">ONE-TIME SETUP</p><h1>Open the<br><em>reading room.</em></h1><p>This page is available only before an administrator account exists.</p></div>
  <div class="form-panel"><h2>Create administrator</h2>
    <form action="/setup-admin" method="post" class="stack-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label>Display name<input name="displayName" required maxlength="80"></label>
      <label>User ID<input name="userId" required minlength="3" maxlength="40"></label>
      <label>Email<input name="email" type="email" maxlength="120"></label>
      <div class="field-row"><label>ZIP / postal code<input name="zipCode" required maxlength="16"></label><label>Mobile number<input name="mobile" required maxlength="24"></label></div>
      <label>Password <span class="optional">12 characters minimum</span><input name="password" type="password" required minlength="12" autocomplete="new-password"></label>
      <label>Confirm password<input name="confirmPassword" type="password" required minlength="12" autocomplete="new-password"></label>
      <button class="button button-dark button-full" type="submit">Create admin <span aria-hidden="true">↗</span></button>
    </form>
  </div>
</section>
<%- include('partials/footer') %>
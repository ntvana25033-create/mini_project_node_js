<%- include('partials/header') %>
<section class="dashboard-heading"><div><p class="eyebrow">YOUR READING DESK</p><h1>A shelf of <em>what's next.</em></h1><p>Books selected from the latest advance copies.</p></div><span class="dashboard-mark">R</span></section>
<section class="shelf-section"><div class="section-heading"><div><p class="eyebrow">JUST FOR YOU</p><h2>Recommended reads</h2></div><a class="text-link" href="/">Browse all books ↗</a></div>
  <% if (recommendations.length) { %><div class="book-grid compact-grid"><% recommendations.forEach((book, index) => { %><a class="book-card" href="/books/<%= book._id %>"><div class="book-cover cover-tone-<%= index % 4 %>"><% if (book.coverUrl) { %><img src="<%= book.coverUrl %>" alt="Cover of <%= book.title %>" loading="lazy"><% } else { %><span class="cover-kicker"><%= book.category %></span><span class="cover-title"><%= book.title %></span><span class="cover-author"><%= book.author %></span><% } %><span class="cover-tag">EARLY ACCESS</span></div><div class="book-card-info"><span class="book-category"><%= book.category %></span><h3><%= book.title %></h3><p>by <%= book.author %></p></div></a><% }) %></div><% } else { %><div class="empty-state"><span class="empty-mark">01</span><h3>The shelf is waiting.</h3><p>New advance copies will appear here as publishers share them.</p></div><% } %>
</section>
<section class="account-tools"><p class="eyebrow">ACCOUNT SETTINGS</p><h2>Change password</h2><form action="/change-password" method="post" class="inline-composer"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Current password<input name="currentPassword" type="password" required autocomplete="current-password"></label><label>New password<input name="newPassword" type="password" required minlength="8" autocomplete="new-password"></label><label>Confirm password<input name="confirmPassword" type="password" required minlength="8" autocomplete="new-password"></label><button class="button button-outline" type="submit">Update password</button></form></section>
<%- include('partials/footer') %>
<%- include('partials/header') %>
<section class="dashboard-heading"><div><p class="eyebrow">ADMINISTRATION / OVERVIEW</p><h1>Keep the <em>room in order.</em></h1><p>Review submissions, follow reader response, and manage the community.</p></div><span class="dashboard-mark admin-mark">A</span></section>
<section class="metric-strip"><div><span>Published titles</span><strong><%= publishedBooks %></strong></div><div><span>Awaiting review</span><strong><%= pendingBooks.length %></strong></div><div><span>Reader reviews</span><strong><%= reviewCount %></strong></div><div><span>Private feedback</span><strong><%= feedbackCount %></strong></div></section>
<section class="admin-section"><div class="section-heading"><div><p class="eyebrow">EDITORIAL INBOX</p><h2>Books awaiting review</h2></div><div class="admin-links"><a href="/admin/users">User directory ↗</a><a href="/admin/publishers">Publishers ↗</a><a href="/admin/feedback">Feedback ↗</a></div></div>
  <% if (pendingBooks.length) { pendingBooks.forEach((book) => { %><article class="admin-book-row"><div class="admin-book-copy"><span class="book-category"><%= book.category %></span><h3><%= book.title %></h3><p>By <%= book.author %> · Submitted by <%= book.publisher?.displayName || 'Publisher' %></p><p class="admin-description"><%= book.description %></p></div><div class="moderation-actions"><a class="text-link" href="/books/<%= book._id %>">Preview ↗</a><form method="post" action="/admin/books/<%= book._id %>/moderate"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="status" value="published"><button class="button button-dark" type="submit">Approve</button></form><form method="post" action="/admin/books/<%= book._id %>/moderate"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="status" value="rejected"><button class="button button-outline" type="submit">Reject</button></form></div></article><% }) } else { %><div class="empty-state compact-empty"><span class="empty-mark">✓</span><h3>All caught up.</h3><p>New publisher submissions will land here.</p></div><% } %>
</section>
<section class="admin-section analysis-section"><div class="section-heading"><div><p class="eyebrow">BOOK ANALYSIS</p><h2>By category</h2></div></div><div class="analysis-table"><div class="analysis-row analysis-head"><span>Category</span><span>Published titles</span><span>Average rating</span></div><% if (analysis.length) { analysis.forEach((item) => { %><div class="analysis-row"><strong><%= item._id %></strong><span><%= item.books %></span><span><%= item.averageRating ? item.averageRating.toFixed(1) + ' / 5' : 'No ratings' %></span></div><% }) } else { %><p class="empty-line">Analysis will appear when books are published.</p><% } %></div></section>
<%- include('partials/footer') %>
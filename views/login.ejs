<%- include('partials/header') %>
<section class="auth-layout">
  <div class="auth-aside"><p class="eyebrow">WELCOME BACK</p><h1>Your next<br><em>read awaits.</em></h1><p>Pick up where the first chapter left off.</p></div>
  <div class="form-panel"><p class="eyebrow">READER ACCESS</p><h2>Sign in</h2>
    <% if (notice) { %><p class="notice"><%= notice %></p><% } %>
    <form action="/login" method="post" class="stack-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label>User ID<input name="userId" autocomplete="username" required maxlength="40"></label>
      <label>Password<input name="password" type="password" autocomplete="current-password" required></label>
      <button class="button button-dark button-full" type="submit">Sign in <span aria-hidden="true">↗</span></button>
    </form>
    <div class="form-links"><a href="/forgot-password">Forgot password?</a><a href="/register">Create account</a></div>
  </div>
</section>
<%- include('partials/footer') %>